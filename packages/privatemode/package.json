{
  "name": "pi-privatemode",
  "version": "0.1.0",
  "description": "Privatemode provider for Pi with pinned manifest admission and request-owned attested encryption",
  "type": "module",
  "license": "MIT",
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "manifests",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "pi-tee-core": "0.1.0",
    "privatemode-ai": "1.58.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariofrio/pi-tee.git",
    "directory": "packages/privatemode"
  }
}
