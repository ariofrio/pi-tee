 namespace nvattestation {
 
+// pi-tee: the certificates of the root's signature, in document order.
+static const char* const RIM_CERTIFICATES_XPATH = "/ns0:SoftwareIdentity/ds:Signature/ds:KeyInfo/ds:X509Data/ds:X509Certificate";
+
     
 // ref: https://github.com/nlohmann/json?tab=readme-ov-file#simplify-your-life-with-macros
 NLOHMANN_DEFINE_TYPE_NON_INTRUSIVE(RimResponse, id, rim, request_id, sha256);
 
+// pi-tee: require NVIDIA's RIM signature layout: no DTD; one ds:Signature,
+// the root's last element, holding SignedInfo, SignatureValue and X509Data
+// certificates; one whole-document reference with the enveloped-signature and
+// C14N 1.1 transforms.
+static bool is_dsig_element(xmlNodePtr node, const char* name) {
+    return node != nullptr && node->type == XML_ELEMENT_NODE && node->ns != nullptr &&
+        xmlStrEqual(node->name, BAD_CAST name) && xmlStrEqual(node->ns->href, BAD_CAST RimDocument::XML_DSIG_NAMESPACE_URI);
+}
+
+static xmlNodePtr next_element(xmlNodePtr node) {
+    while (node != nullptr && node->type != XML_ELEMENT_NODE) {
+        node = node->next;
+    }
+    return node;
+}
+
+static xmlNodePtr first_child_element(xmlNodePtr node) {
+    return node == nullptr ? nullptr : next_element(node->children);
+}
+
+static xmlNodePtr next_sibling_element(xmlNodePtr node) {
+    return node == nullptr ? nullptr : next_element(node->next);
+}
+
+static bool has_algorithm(xmlNodePtr node, const xmlChar* algorithm) {
+    auto value = nv_unique_ptr<xmlChar>(xmlGetNoNsProp(node, BAD_CAST "Algorithm"));
+    return value && xmlStrEqual(value.get(), algorithm) && first_child_element(node) == nullptr;
+}
+
+static Error get_signature_node(xmlDocPtr doc, xmlNodePtr& out_signature) {
+    xmlNodePtr root = xmlDocGetRootElement(doc);
+    if (root == nullptr || doc->intSubset != nullptr || doc->extSubset != nullptr || root->ns == nullptr ||
+            !xmlStrEqual(root->name, BAD_CAST "SoftwareIdentity") ||
+            !xmlStrEqual(root->ns->href, BAD_CAST RimDocument::ISO_19770_SCHEMA_NAMESPACE_URI)) {
+        LOG_ERROR("RIM is not a SoftwareIdentity document without a DTD");
+        return Error::RimInvalidSignature;
+    }
+
+    // Exactly one ds:Signature, the root's last element.
+    auto x_path_ctx = nv_unique_ptr<xmlXPathContext>(xmlXPathNewContext(doc));
+    if (!x_path_ctx || xmlXPathRegisterNs(x_path_ctx.get(), BAD_CAST "ds", BAD_CAST RimDocument::XML_DSIG_NAMESPACE_URI) != 0) {
+        LOG_ERROR("Failed to create XPath context");
+        return Error::InternalError;
+    }
+    auto signatures = nv_unique_ptr<xmlXPathObject>(xmlXPathEvalExpression(BAD_CAST "//ds:Signature", x_path_ctx.get()));
+    xmlNodePtr signature = nullptr;
+    for (xmlNodePtr child = first_child_element(root); child != nullptr; child = next_sibling_element(child)) {
+        signature = child;
+    }
+    if (!signatures || signatures->nodesetval == nullptr || signatures->nodesetval->nodeNr != 1 ||
+            signatures->nodesetval->nodeTab[0] != signature || !is_dsig_element(signature, "Signature")) {
+        LOG_ERROR("RIM must contain one signature, as the root's last element");
+        return Error::RimInvalidSignature;
+    }
+
+    // Signature: SignedInfo, SignatureValue and KeyInfo with only X509Data certificates.
+    xmlNodePtr signed_info = first_child_element(signature);
+    xmlNodePtr signature_value = next_sibling_element(signed_info);
+    xmlNodePtr key_info = next_sibling_element(signature_value);
+    xmlNodePtr x509_data = first_child_element(key_info);
+    if (!is_dsig_element(signed_info, "SignedInfo") || !is_dsig_element(signature_value, "SignatureValue") ||
+            first_child_element(signature_value) != nullptr || !is_dsig_element(key_info, "KeyInfo") ||
+            next_sibling_element(key_info) != nullptr || !is_dsig_element(x509_data, "X509Data") ||
+            next_sibling_element(x509_data) != nullptr || first_child_element(x509_data) == nullptr) {
+        LOG_ERROR("RIM signature has unexpected elements");
+        return Error::RimInvalidSignature;
+    }
+    for (xmlNodePtr cert = first_child_element(x509_data); cert != nullptr; cert = next_sibling_element(cert)) {
+        if (!is_dsig_element(cert, "X509Certificate") || first_child_element(cert) != nullptr) {
+            LOG_ERROR("RIM KeyInfo must contain only X509 certificates");
+            return Error::RimInvalidSignature;
+        }
+    }
+
+    // SignedInfo: one whole-document reference with the enveloped-signature
+    // and C14N 1.1 transforms.
+    xmlNodePtr c14n_method = first_child_element(signed_info);
+    xmlNodePtr signature_method = next_sibling_element(c14n_method);
+    xmlNodePtr reference = next_sibling_element(signature_method);
+    xmlNodePtr transforms = first_child_element(reference);
+    xmlNodePtr digest_method = next_sibling_element(transforms);
+    xmlNodePtr digest_value = next_sibling_element(digest_method);
+    xmlNodePtr enveloped = first_child_element(transforms);
+    xmlNodePtr c14n = next_sibling_element(enveloped);
+    auto uri = nv_unique_ptr<xmlChar>(reference == nullptr ? nullptr : xmlGetNoNsProp(reference, BAD_CAST "URI"));
+    if (!is_dsig_element(c14n_method, "CanonicalizationMethod") || !is_dsig_element(signature_method, "SignatureMethod") ||
+            !is_dsig_element(reference, "Reference") || next_sibling_element(reference) != nullptr || !uri || uri.get()[0] != '\0' ||
+            !is_dsig_element(transforms, "Transforms") || !is_dsig_element(digest_method, "DigestMethod") ||
+            !is_dsig_element(digest_value, "DigestValue") || next_sibling_element(digest_value) != nullptr ||
+            !is_dsig_element(enveloped, "Transform") || !has_algorithm(enveloped, xmlSecHrefEnveloped) ||
+            !is_dsig_element(c14n, "Transform") || !has_algorithm(c14n, xmlSecHrefC14N11) || next_sibling_element(c14n) != nullptr) {
+        LOG_ERROR("RIM signature must have one whole-document reference");
+        return Error::RimInvalidSignature;
+    }
+
+    out_signature = signature;
+    return Error::Ok;
+}
