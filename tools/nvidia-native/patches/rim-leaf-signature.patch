+// pi-tee: returns the first X509Certificate exactly as get_cert_chain() uses it.
+static Error get_first_x509_certificate_pem(xmlDocPtr doc, const char* dsig_namespace, std::string& out_cert) {
+    auto x_path_ctx = nv_unique_ptr<xmlXPathContext>(xmlXPathNewContext(doc));
+    if (!x_path_ctx) {
+        LOG_ERROR("Failed to create XPath context");
+        return Error::InternalError;
+    }
+    if (xmlXPathRegisterNs(x_path_ctx.get(), BAD_CAST "ds", BAD_CAST dsig_namespace) != 0) {
+        LOG_ERROR("Failed to register namespace");
+        return Error::InternalError;
+    }
+    auto x_path_obj = nv_unique_ptr<xmlXPathObject>(xmlXPathEvalExpression(BAD_CAST "//ds:X509Certificate", x_path_ctx.get()));
+    if (!x_path_obj || x_path_obj->nodesetval == nullptr || x_path_obj->nodesetval->nodeNr == 0) {
+        LOG_ERROR("No X509Certificate found in RIM data");
+        return Error::RimInvalidSignature;
+    }
+    auto content = nv_unique_ptr<xmlChar>(xmlNodeGetContent(x_path_obj->nodesetval->nodeTab[0]));
+    if (!content) {
+        LOG_ERROR("Failed to read RIM leaf certificate");
+        return Error::RimInvalidSignature;
+    }
+    out_cert = "-----BEGIN CERTIFICATE-----\n"
+               + std::string(reinterpret_cast<const char*>(content.get())) +
+               "-----END CERTIFICATE-----";
     return Error::Ok;
 }
 
